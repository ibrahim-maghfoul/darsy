    {
      "parameters": {
        "jsCode": "// Normalize all UGC into a common format\nconst twitterData = $('Twitter: Search Hashtags').first().json;\nconst igData = $('IG: Recent Hashtag Media').first().json;\nconst fbData = $('FB: Tagged Posts').first().json;\nconst ugcItems = [];\n\n// Process Twitter\nif (twitterData.data) {\n  const mediaMap = {};\n  if (twitterData.includes?.media) {\n    for (const m of twitterData.includes.media) {\n      mediaMap[m.media_key] = m;\n    }\n  }\n  const userMap = {};\n  if (twitterData.includes?.users) {\n    for (const u of twitterData.includes.users) {\n      userMap[u.id] = u;\n    }\n  }\n  for (const tweet of twitterData.data) {\n    const user = userMap[tweet.author_id] || {};\n    const mediaKeys = tweet.attachments?.media_keys || [];\n    const media = mediaKeys.map(k => mediaMap[k]).filter(Boolean);\n    ugcItems.push({\n      platform: 'twitter',\n      post_id: tweet.id,\n      author: user.username || tweet.author_id,\n      text: tweet.text,\n      media_url: media[0]?.url || media[0]?.preview_image_url || '',\n      media_type: media[0]?.type || 'unknown',\n      permalink: `https://twitter.com/${user.username}/status/${tweet.id}`,\n      engagement: (tweet.public_metrics?.like_count || 0) + (tweet.public_metrics?.retweet_count || 0),\n      created_at: tweet.created_at\n    });\n  }\n}\n\n// Process Instagram\nif (igData.data) {\n  for (const post of igData.data) {\n    ugcItems.push({\n      platform: 'instagram',\n      post_id: post.id,\n      author: post.username,\n      text: post.caption || '',\n      media_url: post.media_url || '',\n      media_type: post.media_type?.toLowerCase() || 'image',\n      permalink: post.permalink,\n      engagement: 0,\n      created_at: post.timestamp\n    });\n  }\n}\n\n// Process Facebook\nif (fbData.data) {\n  for (const post of fbData.data) {\n    ugcItems.push({\n      platform: 'facebook',\n      post_id: post.id,\n      author: post.from?.name || 'Unknown',\n      text: post.message || '',\n      media_url: post.full_picture || '',\n      media_type: post.full_picture ? 'image' : 'text',\n      permalink: post.permalink_url || `https://facebook.com/${post.id}`,\n      engagement: 0,\n      created_at: post.created_time\n    });\n  }\n}\n\nreturn ugcItems.length > 0 \n  ? ugcItems.map(item => ({ json: item }))\n  : [{ json: { _empty: true } }];"
      },
      "id": "normalize-ugc",
      "name": "Normalize All UGC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
