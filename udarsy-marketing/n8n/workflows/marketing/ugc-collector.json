        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are the social media manager for Udarsy (دارسي), a Moroccan educational platform targeting BAC and Brevet students in Morocco. Write a repost caption that gives proper credit to the original creator.\\n\\nGuidelines:\\n- Start with an engaging hook\\n- Credit the original creator with their username\\n- Add 2-3 relevant hashtags\\n- Write in Arabic (Moroccan dialect) with French subtitle\\n- Keep it under 200 characters for the main caption\\n- Be warm and appreciative\\n\\nFormat:\\n[Arabic caption]\\n\\n[French subtitle]\\n\\nCredit: @[username]\\n#Udarsy #دارسي [other hashtags]\"},{\"role\":\"user\",\"content\":\"=Write a repost caption for this UGC:\\n\\nPlatform: {{ $json.platform }}\\nAuthor: {{ $json.author }}\\nOriginal text: {{ $json.text }}\\nContent type: {{ $json.ugc_content_type }}\"}], temperature: 0.7, max_tokens: 300 }) }}",
