    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are a content curator for Udarsy (دارسي), a Moroccan educational platform targeting BAC and Brevet students in Morocco. Evaluate user-generated content for repost quality.\\n\\nScore each piece of UGC from 1-10 based on:\\n- Relevance to education/Udarsy (0-3 points)\\n- Visual quality / appeal (0-3 points)\\n- Positive sentiment (0-2 points)\\n- Engagement potential (0-2 points)\\n\\nRespond with ONLY a JSON object:\\n{\\n  \\\"score\\\": 1-10,\\n  \\\"worthy\\\": true/false,\\n  \\\"reason\\\": \\\"brief explanation\\\",\\n  \\\"content_type\\\": \\\"testimonial|study_tip|achievement|creative|other\\\"\\n}\\n\\nSet worthy=true only if score >= 7.\"},{\"role\":\"user\",\"content\":\"=Evaluate this UGC for reposting:\\n\\nPlatform: {{ $json.platform }}\\nAuthor: {{ $json.author }}\\nText: {{ $json.text }}\\nMedia type: {{ $json.media_type }}\\nEngagement: {{ $json.engagement }}\"}], temperature: 0.2, max_tokens: 200 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ai-filter-quality",
      "name": "AI: Filter Quality UGC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet evaluation;\ntry {\n  const content = item.message?.content || item.choices?.[0]?.message?.content || '{}';\n  evaluation = JSON.parse(content);\n} catch (e) {\n  evaluation = { score: 0, worthy: false, reason: 'parse error', content_type: 'other' };\n}\n\nreturn [{\n  json: {\n    ...item,\n    ugc_score: evaluation.score,\n    ugc_worthy: evaluation.worthy,\n    ugc_reason: evaluation.reason,\n    ugc_content_type: evaluation.content_type\n  }\n}];"
      },
      "id": "parse-quality-score",
      "name": "Parse Quality Score",
      "type": "n8n-nodes-base.code",
