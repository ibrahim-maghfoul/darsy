{
  "name": "Udarsy - AI Smart Weekly Newsletter",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtDay": 5,
              "triggerAtHour": 14
            }
          ]
        }
      },
      "id": "cron-friday-2pm",
      "name": "Every Friday 2PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ],
      "notes": "Weekly newsletter preparation starts every Friday at 2:00 PM"
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/data/lessons",
        "options": {
          "queryParameters": {
            "parameters": [
              {
                "name": "sort",
                "value": "viewCount"
              },
              {
                "name": "order",
                "value": "desc"
              },
              {
                "name": "limit",
                "value": "5"
              },
              {
                "name": "period",
                "value": "week"
              }
            ]
          }
        }
      },
      "id": "fetch-trending-lessons",
      "name": "Fetch: Top 5 Trending Lessons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "notes": "Gets the 5 most viewed/completed lessons from the past week"
    },
    {
      "parameters": {
        "url": "http://localhost:5000/api/news",
        "options": {
          "queryParameters": {
            "parameters": [
              {
                "name": "sort",
                "value": "date"
              },
              {
                "name": "order",
                "value": "desc"
              },
              {
                "name": "limit",
                "value": "3"
              }
            ]
          }
        }
      },
      "id": "fetch-news",
      "name": "Fetch: Latest 3 News Articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        360
      ]
    },
    {
      "parameters": {
        "operation": "aggregate",
        "collection": "contributions",
        "query": "[\n  { \"$match\": { \"status\": \"approved\", \"createdAt\": { \"$gte\": { \"$dateSubtract\": { \"startDate\": \"$$NOW\", \"unit\": \"week\", \"amount\": 1 } } } } },\n  { \"$group\": { \"_id\": \"$userId\", \"count\": { \"$sum\": 1 } } },\n  { \"$sort\": { \"count\": -1 } },\n  { \"$limit\": 1 },\n  { \"$lookup\": { \"from\": \"users\", \"localField\": \"_id\", \"foreignField\": \"_id\", \"as\": \"user\" } },\n  { \"$unwind\": \"$user\" },\n  { \"$project\": { \"displayName\": \"$user.displayName\", \"photoURL\": \"$user.photoURL\", \"contributionCount\": \"$count\" } }\n]",
        "options": {}
      },
      "id": "fetch-top-contributor",
      "name": "Fetch: Top Contributor of the Week",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        480,
        520
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CREDENTIAL_ID",
          "name": "Udarsy MongoDB"
        }
      }
    },
    {
      "parameters": {
        "operation": "aggregate",
        "collection": "users",
        "query": "[\n  { \"$facet\": {\n    \"newUsersThisWeek\": [\n      { \"$match\": { \"createdAt\": { \"$gte\": { \"$dateSubtract\": { \"startDate\": \"$$NOW\", \"unit\": \"week\", \"amount\": 1 } } } } },\n      { \"$count\": \"count\" }\n    ],\n    \"totalUsers\": [ { \"$count\": \"count\" } ],\n    \"lessonsCompletedThisWeek\": [\n      { \"$unwind\": \"$progress.lessons\" },\n      { \"$match\": { \"progress.lessons.lastAccessed\": { \"$gte\": { \"$dateSubtract\": { \"startDate\": \"$$NOW\", \"unit\": \"week\", \"amount\": 1 } } } } },\n      { \"$count\": \"count\" }\n    ]\n  } }\n]",
        "options": {}
      },
      "id": "fetch-platform-stats",
      "name": "Fetch: Platform Stats",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        480,
        680
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CREDENTIAL_ID",
          "name": "Udarsy MongoDB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lessons = $('Fetch: Top 5 Trending Lessons').first().json;\nconst news = $('Fetch: Latest 3 News Articles').first().json;\nconst contributor = $('Fetch: Top Contributor of the Week').first().json;\nconst stats = $('Fetch: Platform Stats').first().json;\n\nreturn [{\n  json: {\n    trendingLessons: Array.isArray(lessons) ? lessons : (lessons?.data || []),\n    latestNews: Array.isArray(news) ? news : (news?.data || []),\n    topContributor: contributor || { displayName: 'N/A', contributionCount: 0 },\n    stats: {\n      newUsers: stats?.newUsersThisWeek?.[0]?.count || 0,\n      totalUsers: stats?.totalUsers?.[0]?.count || 0,\n      lessonsCompleted: stats?.lessonsCompletedThisWeek?.[0]?.count || 0\n    }\n  }\n}];"
      },
      "id": "merge-data",
      "name": "Merge All Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are a bilingual (Arabic + French) newsletter writer for Udarsy, a Moroccan educational platform targeting BAC and Brevet students in Morocco. Currency: MAD (Moroccan Dirham). School calendar: BAC in June, Brevet in May, school starts in September. Write engaging, warm, and motivational content. Use a friendly tone that resonates with Moroccan students. Output valid HTML for email.\"},{\"role\":\"user\",\"content\":\"=Write a weekly newsletter email in Arabic (primary) with French translation below each section. Include these sections:\\n\\n1. TRENDING LESSONS THIS WEEK:\\n{{ JSON.stringify($json.trendingLessons) }}\\n\\n2. LATEST NEWS:\\n{{ JSON.stringify($json.latestNews) }}\\n\\n3. TOP CONTRIBUTOR:\\n{{ JSON.stringify($json.topContributor) }}\\n\\n4. PLATFORM STATS:\\n- New users this week: {{ $json.stats.newUsers }}\\n- Total users: {{ $json.stats.totalUsers }}\\n- Lessons completed this week: {{ $json.stats.lessonsCompleted }}\\n\\nFormat as clean HTML email content (just the body content, no full HTML document). Use RTL direction for Arabic. Keep it concise and engaging. Add emojis sparingly.\"}], temperature: 0.7, max_tokens: 2000 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "gpt-write-newsletter",
      "name": "GPT-4o: Write Newsletter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
        }
      },
      "notes": "Generates bilingual Arabic+French newsletter content using GPT-4o"
    },
    {
      "parameters": {
        "jsCode": "const aiContent = $input.first().json.text || $input.first().json.message?.content || '';\nconst stats = $('Merge All Data').first().json.stats;\n\nconst html = `<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"ar\">\n<head><meta charset=\"UTF-8\"><style>\nbody { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f4f6f9; margin: 0; padding: 0; }\n.container { max-width: 650px; margin: 20px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.08); }\n.header { background: linear-gradient(135deg, #6C63FF, #4ECDC4); padding: 40px 30px; text-align: center; color: #fff; }\n.header h1 { margin: 0; font-size: 32px; }\n.header p { margin: 8px 0 0; opacity: 0.9; font-size: 16px; }\n.body-content { padding: 30px; color: #444; line-height: 1.8; }\n.section { margin: 24px 0; padding: 20px; background: #f8f9ff; border-radius: 10px; }\n.section h2 { color: #6C63FF; margin: 0 0 12px; font-size: 18px; }\n.stats-grid { display: flex; justify-content: space-around; text-align: center; margin: 20px 0; }\n.stat { padding: 16px; }\n.stat .number { font-size: 28px; font-weight: 700; color: #6C63FF; }\n.stat .label { font-size: 12px; color: #888; }\n.cta { display: block; width: fit-content; margin: 24px auto; padding: 14px 40px; background: #6C63FF; color: #fff; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: 600; text-align: center; }\n.footer { text-align: center; padding: 20px; color: #999; font-size: 12px; border-top: 1px solid #eee; }\n</style></head>\n<body><div class=\"container\">\n  <div class=\"header\">\n    <h1>Udarsy Weekly</h1>\n    <p>  </p>\n  </div>\n  <div class=\"body-content\">\n    ${aiContent}\n    <div class=\"stats-grid\">\n      <div class=\"stat\"><div class=\"number\">${stats.newUsers}</div><div class=\"label\">  </div></div>\n      <div class=\"stat\"><div class=\"number\">${stats.lessonsCompleted}</div><div class=\"label\">  </div></div>\n      <div class=\"stat\"><div class=\"number\">${stats.totalUsers}</div><div class=\"label\"> </div></div>\n    </div>\n    <a href=\"https://udarsy.dz/explore\" class=\"cta\"> </a>\n  </div>\n  <div class=\"footer\">\n    <p>Udarsy -   </p>\n    <p><a href=\"https://udarsy.dz/unsubscribe\"> </a></p>\n  </div>\n</div></body></html>`;\n\nreturn [{ json: { htmlEmail: html } }];"
      },
