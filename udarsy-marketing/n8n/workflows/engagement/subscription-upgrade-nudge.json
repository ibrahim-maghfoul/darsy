      "typeVersion": 1.2,
      "position": [
        240,
        900
      ]
    },
    {
      "parameters": {
        "operation": "aggregate",
        "collection": "users",
        "query": "[\n  { \"$facet\": {\n    \"freeUsers\": [ { \"$match\": { \"subscription.plan\": \"free\" } }, { \"$count\": \"count\" } ],\n    \"premiumUsers\": [ { \"$match\": { \"subscription.plan\": \"premium\" } }, { \"$count\": \"count\" } ],\n    \"proUsers\": [ { \"$match\": { \"subscription.plan\": \"pro\" } }, { \"$count\": \"count\" } ],\n    \"newPremiumThisWeek\": [\n      { \"$match\": { \"subscription.plan\": { \"$in\": [\"premium\", \"pro\"] }, \"updatedAt\": { \"$gte\": { \"$dateSubtract\": { \"startDate\": \"$$NOW\", \"unit\": \"week\", \"amount\": 1 } } } } },\n      { \"$count\": \"count\" }\n    ]\n  } }\n]",
        "options": {}
      },
      "id": "mongo-conversion-stats",
