        "text": "=**Udarsy Conversion Weekly Report**\n\nFree users: {{ $json.freeUsers?.[0]?.count || 0 }}\nPremium users: {{ $json.premiumUsers?.[0]?.count || 0 }}\nPro users: {{ $json.proUsers?.[0]?.count || 0 }}\nNew premium this week: {{ $json.newPremiumThisWeek?.[0]?.count || 0 }}\n\nConversion rate: {{ (($json.premiumUsers?.[0]?.count || 0) + ($json.proUsers?.[0]?.count || 0)) / (($json.freeUsers?.[0]?.count || 1) + ($json.premiumUsers?.[0]?.count || 0) + ($json.proUsers?.[0]?.count || 0)) * 100 }}%",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
