{
  "name": "Referral Program Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "referral-signup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-referral",
      "name": "Webhook - Referral Signup",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "referral-signup"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst newUserId = body.newUserId;\nconst referralCode = body.referralCode;\nconst newUserEmail = body.email;\nconst newUserName = body.name;\n\nif (!referralCode || !newUserId) {\n  throw new Error('Missing referralCode or newUserId');\n}\n\nreturn [{ json: { newUserId, referralCode, newUserEmail, newUserName } }];"
      },
      "id": "validate-input",
      "name": "Validate Referral Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:5000/api/user/referrer/{{ $json.referralCode }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "find-referrer",
      "name": "Find Referrer by Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const referrer = $input.first().json;\nconst referralData = $('Validate Referral Data').first().json;\n\nconst newCount = (referrer.referralCount || 0) + 1;\n\n// Check milestones\nconst milestones = [5, 10, 25, 50, 100];\nconst hitMilestone = milestones.find(m => newCount === m);\n\n// Rewards per milestone\nconst rewards = {\n  5: { premiumDays: 7, badge: 'Starter Referrer' },\n  10: { premiumDays: 14, badge: 'Active Referrer' },\n  25: { premiumDays: 30, badge: 'Super Referrer' },\n  50: { premiumDays: 60, badge: 'Elite Referrer' },\n  100: { premiumDays: 365, badge: 'Legend Referrer' }\n};\n\nreturn [{\n  json: {\n    referrerId: referrer._id,\n    referrerName: referrer.displayName || referrer.email,\n    referrerEmail: referrer.email,\n    newCount,\n    hitMilestone: hitMilestone || null,\n    reward: hitMilestone ? rewards[hitMilestone] : null,\n    newUserEmail: referralData.newUserEmail,\n    newUserName: referralData.newUserName,\n    referralCode: referralData.referralCode\n  }\n}];"
      },
      "id": "check-milestones",
      "name": "Check Milestones & Rewards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/user/referral-count/increment",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.referrerId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "increment-count",
      "name": "Increment Referral Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "noreply@udarsy.app",
        "toEmail": "={{ $('Check Milestones & Rewards').first().json.referrerEmail }}",
        "subject": "=🎉 Someone joined Udarsy using your code!",
        "html": "=<h2>Great news, {{ $('Check Milestones & Rewards').first().json.referrerName }}!</h2><p><strong>{{ $('Check Milestones & Rewards').first().json.newUserName }}</strong> just joined Udarsy using your referral code.</p><p>Total referrals: <strong>{{ $('Check Milestones & Rewards').first().json.newCount }}</strong></p><p>Keep sharing and unlock amazing rewards!</p>"
      },
      "id": "email-referrer",
      "name": "Email Referrer - New Signup",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "fromEmail": "noreply@udarsy.app",
        "toEmail": "={{ $('Check Milestones & Rewards').first().json.newUserEmail }}",
        "subject": "=🎓 Welcome to Udarsy! Your friend invited you",
        "html": "=<h2>Welcome to Udarsy, {{ $('Check Milestones & Rewards').first().json.newUserName }}!</h2><p>You were invited by <strong>{{ $('Check Milestones & Rewards').first().json.referrerName }}</strong>. As a welcome bonus, you get <strong>3 days of free premium access</strong>!</p><p>Start exploring lessons now and supercharge your learning.</p>"
      },
      "id": "email-new-user",
      "name": "Email New User - Welcome Bonus",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $('Check Milestones & Rewards').first().json.hitMilestone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      },
      "id": "check-if-milestone",
      "name": "Hit Milestone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/user/subscribe",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $('Check Milestones & Rewards').first().json.referrerId }}"
            },
            {
              "name": "bonusDays",
              "value": "={{ $('Check Milestones & Rewards').first().json.reward.premiumDays }}"
            },
            {
              "name": "reason",
              "value": "=referral_milestone_{{ $('Check Milestones & Rewards').first().json.hitMilestone }}"
            }
          ]
        },
        "options": {}
      },
      "id": "grant-reward",
      "name": "Grant Premium Reward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🏆 *REFERRAL MILESTONE!*\n\n{{ $('Check Milestones & Rewards').first().json.referrerName }} hit *{{ $('Check Milestones & Rewards').first().json.hitMilestone }} referrals!*\n\nBadge: {{ $('Check Milestones & Rewards').first().json.reward.badge }}\nReward: {{ $('Check Milestones & Rewards').first().json.reward.premiumDays }} days premium\n\nTotal referral signups today: check sheets",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-milestone",
      "name": "Telegram - Milestone Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1760,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "XKvv8ek8iXO8xWJT",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.CONTENT_SHEET_ID }}"
        },
        "sheetName": "Referrals",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $now.format('yyyy-MM-dd HH:mm') }}",
            "referrer": "={{ $('Check Milestones & Rewards').first().json.referrerName }}",
            "new_user": "={{ $('Check Milestones & Rewards').first().json.newUserName }}",
            "total_referrals": "={{ $('Check Milestones & Rewards').first().json.newCount }}",
            "milestone": "={{ $('Check Milestones & Rewards').first().json.hitMilestone || 'none' }}"
          }
        },
        "options": {}
      },
      "id": "log-sheets",
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GEdm4SCZIB4132yL",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-referral-report",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "run-referral-report-wh",
      "name": "Webhook Trigger (Bot)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        160
      ],
      "webhookId": "run-referral-report-wh"
    }
  ],
