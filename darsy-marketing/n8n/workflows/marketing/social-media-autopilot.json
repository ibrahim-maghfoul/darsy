        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.caption_ar }}\\n\\n{{ $json.caption_en }}\\n\\n{{ $json.hashtags }}\\n{{ $json.link || '' }}\",\n  \"media\": {\n    \"media_ids\": [\"{{ $json.twitter_media_id }}\"]\n  }\n}",
