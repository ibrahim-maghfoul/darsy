            {
              "outputIndex": 1,
              "value": "instagram"
            },
            {
              "outputIndex": 2,
              "value": "twitter"
            },
            {
              "outputIndex": 3,
              "value": "linkedin"
            },
            {
              "outputIndex": 4,
              "value": "tiktok"
            }
          ]
        },
        "dataPropertyName": "={{ $json.platform }}",
        "fallbackOutput": "extra"
      },
