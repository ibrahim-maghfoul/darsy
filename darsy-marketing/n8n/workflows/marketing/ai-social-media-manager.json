    {
      "parameters": {
        "jsCode": "// Merge all data sources for the AI agent\nconst trendsDataMA = $('Fetch Morocco Trends').first().json.data || '';\nconst darsyStats = $('Fetch Darsy Platform Stats').first().json;\nconst calendarItems = $('Read Content Calendar').all().map(i => i.json);\n\n// Parse Morocco trends\nlet moroccoTrends = [];\ntry {\n  moroccoTrends = trendsDataMA.toString().split('\\n').filter(Boolean).slice(0, 10);\n} catch(e) { moroccoTrends = []; }\n\nconst today = new Date();\nconst dayOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][today.getDay()];\n\nreturn [{\n  json: {\n    moroccoTrends,\n    darsyStats,\n    calendarItems,\n    dayOfWeek,\n    date: today.toISOString().split('T')[0],\n    context: {\n      totalUsers: darsyStats?.totalUsers || 'unknown',\n      totalLessons: darsyStats?.totalLessons || 'unknown',\n      totalSubjects: darsyStats?.totalSubjects || 'unknown'\n    }\n  }\n}];"
      },
      "id": "merge-data-sources",
      "name": "Merge All Data Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are a senior social media manager for Darsy, a Moroccan educational platform targeting BAC and Brevet students in Morocco. Languages: Arabic (Darija + MSA) and French. Currency: MAD. School calendar: BAC in June, Brevet in May, school starts in September. Analyze today's trends, check what content is scheduled, review yesterday's performance, and create 3 optimized posts for today. Consider the Moroccan audience, use appropriate mix of Arabic (Darija), French, and educational content. Prioritize engagement and growth.\\n\\nYou have access to:\\n- Google Trends data from Morocco\\n- The Darsy content calendar\\n- Platform statistics (users, lessons, subjects)\\n\\nRules:\\n1. Each post must be for a different platform: Facebook, Instagram, Twitter/X\\n2. Use Moroccan Darija or French naturally - do not force classical Arabic\\n3. Include relevant hashtags in Arabic and French\\n4. Reference trending topics when they can be tied to education\\n5. Vary post types: carousel idea, reel concept, static post, poll, story\\n6. Include a CTA (call to action) in every post\\n7. If it is Friday, include something motivational/spiritual\\n8. If exams are near, focus on study tips and encouragement\\n\\nYour output MUST be valid JSON with this structure:\\n{\\n  \\\"analysis\\\": \\\"Brief analysis of trends and what to leverage\\\",\\n  \\\"posts\\\": [\\n    {\\n      \\\"platform\\\": \\\"facebook|instagram|twitter\\\",\\n      \\\"type\\\": \\\"static|carousel|reel|poll|story\\\",\\n      \\\"language\\\": \\\"ar-dz|fr|mixed\\\",\\n      \\\"text\\\": \\\"The post caption/text\\\",\\n      \\\"image_prompt\\\": \\\"Detailed DALL-E prompt for the post visual\\\",\\n      \\\"hashtags\\\": [\\\"#tag1\\\", \\\"#tag2\\\"],\\n      \\\"best_time\\\": \\\"HH:MM\\\",\\n      \\\"reasoning\\\": \\\"Why this post will perform well\\\"\\n    }\\n  ]\\n}\"},{\"role\":\"user\",\"content\":\"Date: {{ $json.date }} ({{ $json.dayOfWeek }})\\n\\n--- MOROCCO TRENDS ---\\n{{ JSON.stringify($json.moroccoTrends, null, 2) }}\\n\\n--- DARSY PLATFORM STATS ---\\nTotal Users: {{ $json.context.totalUsers }}\\nTotal Lessons: {{ $json.context.totalLessons }}\\nTotal Subjects: {{ $json.context.totalSubjects }}\\n\\n--- SCHEDULED CONTENT FOR TODAY ---\\n{{ JSON.stringify($json.calendarItems, null, 2) }}\\n\\nCreate 3 optimized posts for today. Make them culturally relevant to Morocco, engaging, and aligned with our educational mission. Platform context: Darsy serves BAC and Brevet students in Morocco. Currency is MAD. Content should mix Arabic (Darija + MSA) and French.\"}], temperature: 0.85, max_tokens: 2500 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ai-agent-strategist",
      "name": "AI Agent - Social Media Strategist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI agent response and split into individual posts\nconst aiResponse = $input.first().json.message?.content || $input.first().json.text;\nlet parsed;\ntry {\n  const jsonStr = aiResponse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  parsed = JSON.parse(jsonStr);\n} catch (e) {\n  throw new Error('Failed to parse AI response as JSON: ' + e.message);\n}\n\nconst posts = parsed.posts || [];\nconst analysis = parsed.analysis || '';\n\nreturn posts.map((post, index) => ({\n  json: {\n    postIndex: index + 1,\n    totalPosts: posts.length,\n    analysis,\n    ...post\n  }\n}));"
      },
      "id": "parse-ai-posts",
      "name": "Parse AI Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"dall-e-3\", prompt: {{ $json.image_prompt }}, n: 1, size: \"1024x1024\", quality: \"hd\", style: \"vivid\" }) }}",
        "options": {}
      },
      "id": "generate-post-image",
      "name": "DALL-E - Generate Post Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        400
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine post data with generated image\nconst postData = $('Parse AI Posts').item;\nconst imageUrl = $input.first().json.data?.[0]?.url || $input.first().json.url || '';\n\nconst platformEmoji = {\n  'facebook': '📘',\n  'instagram': '📸',\n  'twitter': '🐦'\n};\n\nconst approvalMessage = `${platformEmoji[postData.json.platform] || '📱'} *Post ${postData.json.postIndex}/${postData.json.totalPosts} - ${postData.json.platform.toUpperCase()}*\\n\\n` +\n  `📝 *Type:* ${postData.json.type}\\n` +\n  `🌐 *Language:* ${postData.json.language}\\n` +\n  `⏰ *Best time:* ${postData.json.best_time}\\n\\n` +\n  `---\\n${postData.json.text}\\n---\\n\\n` +\n  `${postData.json.hashtags?.join(' ') || ''}\\n\\n` +\n  `💡 *Reasoning:* ${postData.json.reasoning}\\n\\n` +\n  `📊 *Today\\'s Analysis:* ${postData.json.analysis}`;\n\nreturn [{\n  json: {\n    ...postData.json,\n    imageUrl,\n    approvalMessage,\n    callbackApprove: `approve_post_${postData.json.postIndex}_${Date.now()}`,\n    callbackReject: `reject_post_${postData.json.postIndex}_${Date.now()}`,\n    callbackEdit: `edit_post_${postData.json.postIndex}_${Date.now()}`\n  }\n}];"
      },
      "id": "prepare-approval-message",
      "name": "Prepare Approval Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
