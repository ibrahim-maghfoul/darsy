      "id": "read-content-calendar",
      "name": "Read Content Calendar",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        700
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GEdm4SCZIB4132yL",
          "name": "Google Sheets account"
        }
