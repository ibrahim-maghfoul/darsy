      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are an influencer marketing analyst for Darsy (دارسي), a Moroccan educational platform targeting students aged 15-25 in Morocco.\\n\\nScore each influencer's relevance to Darsy on a scale of 1-10 based on:\\n- Education niche fit (0-3): Are they in education, study tips, university life, exam prep?\\n- Audience overlap (0-3): Would their audience be interested in an educational platform?\\n- Engagement quality (0-2): High-quality engagement, not bot-like\\n- Brand safety (0-2): Clean brand, no controversial content\\n\\nRespond with ONLY a JSON object:\\n{\\n  \\\"relevance_score\\\": 1-10,\\n  \\\"engagement_rate_estimate\\\": 0.0-100.0,\\n  \\\"niche_tags\\\": [\\\"education\\\", \\\"study\\\", etc],\\n  \\\"audience_age_estimate\\\": \\\"15-20\\\" or \\\"20-25\\\" or \\\"25+\\\",\\n  \\\"partnership_type\\\": \\\"sponsored_post|ambassador|content_collab|shoutout\\\",\\n  \\\"estimated_cost_usd\\\": 50-5000,\\n  \\\"notes\\\": \\\"brief assessment\\\"\\n}\"},{\"role\":\"user\",\"content\":\"=Evaluate this influencer:\\n\\nPlatform: {{ $json.platform }}\\nUsername: {{ $json.username }}\\nFull name: {{ $json.full_name }}\\nFollowers: {{ $json.followers }}\\nBio: {{ $json.bio }}\\nRegion: {{ $json.region }}\\nRecent post engagement: {{ $json.post_likes }} likes, {{ $json.post_comments }} comments\\nVerified: {{ $json.is_verified }}\"}], temperature: 0.2, max_tokens: 300 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ai-score-relevance",
      "name": "AI: Score Relevance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
