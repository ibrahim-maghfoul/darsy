      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet outreach;\ntry {\n  const content = item.message?.content || item.choices?.[0]?.message?.content || '{}';\n  outreach = JSON.parse(content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim());\n} catch (e) {\n  outreach = { dm_text: '', email_subject: '', email_text: '', outreach_language: 'en' };\n}\n\nreturn [{\n  json: {\n    ...item,\n    dm_text: outreach.dm_text,\n    email_subject: outreach.email_subject,\n    email_text: outreach.email_text,\n    outreach_language: outreach.outreach_language\n  }\n}];"
