    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet evaluation;\ntry {\n  const content = item.message?.content || item.choices?.[0]?.message?.content || '{}';\n  evaluation = JSON.parse(content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim());\n} catch (e) {\n  evaluation = { relevance_score: 0, engagement_rate_estimate: 0, niche_tags: [], partnership_type: 'shoutout', estimated_cost_usd: 0, notes: 'parse error' };\n}\n\nreturn [{\n  json: {\n    ...item,\n    relevance_score: evaluation.relevance_score,\n    engagement_rate_estimate: evaluation.engagement_rate_estimate,\n    niche_tags: evaluation.niche_tags,\n    audience_age: evaluation.audience_age_estimate,\n    partnership_type: evaluation.partnership_type,\n    estimated_cost: evaluation.estimated_cost_usd,\n    ai_notes: evaluation.notes\n  }\n}];"
      },
