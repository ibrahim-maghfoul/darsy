      "id": "tiktok-search-education",
      "name": "TikTok: Education Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract unique creator profiles from search results\nconst igMaData = $('IG: Education Morocco').first().json;\nconst tiktokData = $('TikTok: Education Search').first().json;\nconst creators = [];\nconst seen = new Set();\n\n// Process Instagram Morocco results\nif (igMaData.data?.medias) {\n  for (const post of igMaData.data.medias) {\n    const username = post.user?.username;\n    if (username && !seen.has('ig_' + username)) {\n      seen.add('ig_' + username);\n      creators.push({\n        platform: 'instagram',\n        username: username,\n        full_name: post.user?.full_name || '',\n        profile_url: `https://instagram.com/${username}`,\n        followers: post.user?.follower_count || 0,\n        bio: post.user?.biography || '',\n        is_verified: post.user?.is_verified || false,\n        region: 'morocco',\n        post_likes: post.like_count || 0,\n        post_comments: post.comment_count || 0\n      });\n    }\n  }\n}\n\n// Process TikTok results\nif (tiktokData.data?.challenge_list) {\n  for (const challenge of tiktokData.data.challenge_list) {\n    if (challenge.author) {\n      const uid = challenge.author.unique_id;\n      if (uid && !seen.has('tt_' + uid)) {\n        seen.add('tt_' + uid);\n        creators.push({\n          platform: 'tiktok',\n          username: uid,\n          full_name: challenge.author.nickname || '',\n          profile_url: `https://tiktok.com/@${uid}`,\n          followers: challenge.author.follower_count || 0,\n          bio: challenge.author.signature || '',\n          is_verified: challenge.author.verified || false,\n          region: 'north_africa',\n          post_likes: challenge.stats?.digg_count || 0,\n          post_comments: challenge.stats?.comment_count || 0\n        });\n      }\n    }\n  }\n}\n\nreturn creators.length > 0 \n  ? creators.map(c => ({ json: c }))\n  : [{ json: { _empty: true } }];"
      },
      "id": "extract-creators",
      "name": "Extract Creator Profiles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
