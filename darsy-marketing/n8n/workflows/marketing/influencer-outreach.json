        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are a partnership manager for Darsy (دارسي), a Moroccan educational platform. Write a personalized outreach message to potential influencer partners.\\n\\nGuidelines:\\n- Be professional but friendly\\n- Reference their specific content/niche\\n- Explain Darsy briefly (free educational platform for Moroccan students)\\n- Propose a specific partnership type\\n- Keep it concise (150-200 words)\\n- Write in the language most appropriate for the influencer (Arabic for Arabic-speaking, French for French-speaking)\\n- Include a clear CTA (schedule a call, try the platform, etc.)\\n\\nProvide TWO versions:\\n1. dm_text: Short DM version (for Instagram/TikTok DM, under 500 chars)\\n2. email_text: Full email version (professional, with subject line)\\n\\nRespond as JSON:\\n{\\n  \\\"dm_text\\\": \\\"...\\\",\\n  \\\"email_subject\\\": \\\"...\\\",\\n  \\\"email_text\\\": \\\"...\\\",\\n  \\\"outreach_language\\\": \\\"ar|fr|en\\\"\\n}\"},{\"role\":\"user\",\"content\":\"=Write outreach for this influencer:\\n\\nPlatform: {{ $json.platform }}\\nUsername: {{ $json.username }}\\nName: {{ $json.full_name }}\\nFollowers: {{ $json.followers }}\\nBio: {{ $json.bio }}\\nRegion: {{ $json.region }}\\nNiche: {{ $json.niche_tags?.join(', ') || 'education' }}\\nPartnership type: {{ $json.partnership_type }}\\nEstimated budget: ${{ $json.estimated_cost }}\"}], temperature: 0.7, max_tokens: 800 }) }}",
        "options": {
