    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o\", messages: [{\"role\":\"system\",\"content\":\"You are a sentiment analysis expert for Darsy (دارسي), a Moroccan educational platform targeting BAC and Brevet students in Morocco (Arabic Darija + French, currency MAD). Classify social media mentions into exactly one category.\\n\\nRules:\\n- \\\"positive\\\": Praise, thanks, recommendation, excitement about the platform\\n- \\\"negative\\\": Complaints, bugs, frustration, criticism\\n- \\\"question\\\": Asking about features, pricing, availability, how-to\\n- \\\"spam\\\": Irrelevant, promotional, bot-like content\\n\\nRespond with ONLY a JSON object: {\\\"sentiment\\\": \\\"positive|negative|question|spam\\\", \\\"confidence\\\": 0.0-1.0, \\\"summary_en\\\": \\\"brief English summary\\\", \\\"suggested_reply_lang\\\": \\\"ar|fr|en\\\"}\\n\\nDetect the language of the mention and set suggested_reply_lang accordingly (Arabic content -> ar, French -> fr, English -> en).\"},{\"role\":\"user\",\"content\":\"=Classify this social media mention from {{ $json.platform }}:\\n\\nAuthor: {{ $json.author }}\\nText: {{ $json.text }}\"}], temperature: 0.1, max_tokens: 200 }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "ai-classify-sentiment",
      "name": "AI: Classify Sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and attach sentiment data\nconst item = $input.first().json;\nlet sentiment;\n\ntry {\n  const aiResponse = item.message?.content || item.choices?.[0]?.message?.content || '{}';\n  sentiment = JSON.parse(aiResponse);\n} catch (e) {\n  sentiment = { sentiment: 'spam', confidence: 0, summary_en: 'Failed to parse', suggested_reply_lang: 'en' };\n}\n\nreturn [{\n  json: {\n    ...item,\n    sentiment: sentiment.sentiment,\n    confidence: sentiment.confidence,\n    summary_en: sentiment.summary_en,\n    reply_lang: sentiment.suggested_reply_lang\n  }\n}];"
      },
      "id": "parse-sentiment",
      "name": "Parse Sentiment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        300
      ]
    },
