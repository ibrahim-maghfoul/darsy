    {
      "parameters": {
        "jsCode": "// Extract and normalize comments from Facebook\nconst fbData = $input.first().json;\nconst comments = [];\n\nif (fbData.data) {\n  for (const post of fbData.data) {\n    if (post.comments && post.comments.data) {\n      for (const comment of post.comments.data) {\n        comments.push({\n          platform: 'facebook',\n          comment_id: comment.id,\n          post_id: post.id,\n          text: comment.message,\n          author: comment.from?.name || 'Unknown',\n          author_id: comment.from?.id || '',\n          created_at: comment.created_time,\n          raw: comment\n        });\n      }\n    }\n  }\n}\n\nreturn comments.length > 0 ? comments.map(c => ({ json: c })) : [{ json: { _empty: true, platform: 'facebook' } }];"
      },
      "id": "fb-extract-comments",
      "name": "FB: Extract Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract and normalize comments from Instagram\nconst igData = $input.first().json;\nconst comments = [];\n\nif (igData.data) {\n  for (const media of igData.data) {\n    if (media.comments && media.comments.data) {\n      for (const comment of media.comments.data) {\n        comments.push({\n          platform: 'instagram',\n          comment_id: comment.id,\n          post_id: media.id,\n          text: comment.text,\n          author: comment.username,\n          author_id: comment.username,\n          created_at: comment.timestamp,\n          raw: comment\n        });\n      }\n    }\n  }\n}\n\nreturn comments.length > 0 ? comments.map(c => ({ json: c })) : [{ json: { _empty: true, platform: 'instagram' } }];"
      },
      "id": "ig-extract-comments",
      "name": "IG: Extract Comments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract and normalize tweets\nconst twitterData = $input.first().json;\nconst mentions = [];\n\nif (twitterData.data) {\n  const users = {};\n  if (twitterData.includes && twitterData.includes.users) {\n    for (const u of twitterData.includes.users) {\n      users[u.id] = u;\n    }\n  }\n  \n  // Save the newest tweet ID for next poll\n  const staticData = $getWorkflowStaticData('global');\n  staticData.twitter_since_id = twitterData.meta?.newest_id || staticData.twitter_since_id;\n  \n  for (const tweet of twitterData.data) {\n    const user = users[tweet.author_id] || {};\n    mentions.push({\n      platform: 'twitter',\n      comment_id: tweet.id,\n      post_id: tweet.id,\n      text: tweet.text,\n      author: user.username || tweet.author_id,\n      author_id: tweet.author_id,\n      created_at: tweet.created_at,\n      metrics: tweet.public_metrics,\n      lang: tweet.lang,\n      raw: tweet\n    });\n  }\n}\n\nreturn mentions.length > 0 ? mentions.map(m => ({ json: m })) : [{ json: { _empty: true, platform: 'twitter' } }];"
      },
      "id": "twitter-extract-mentions",
      "name": "Twitter: Extract Mentions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        120
      ]
    },
