    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst thisWeek = items.filter(i => new Date(i.json.Date) >= weekAgo);\n\nconst segments = { '7-day': 0, '14-day': 0, '30-day': 0, '60-day': 0 };\nthisWeek.forEach(i => {\n  if (segments[i.json.Segment] !== undefined) segments[i.json.Segment]++;\n});\n\nreturn [{\n  json: {\n    totalSent: thisWeek.length,\n    segments,\n    weekStart: weekAgo.toISOString().split('T')[0],\n    weekEnd: now.toISOString().split('T')[0]\n  }\n}];"
      },
      "id": "code-weekly-summary",
      "name": "Summarize Weekly Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        900
