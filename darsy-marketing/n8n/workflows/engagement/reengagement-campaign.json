{
  "name": "Darsy - Re-engagement Campaign",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "cron-daily-8am",
      "name": "Daily 8AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ],
      "notes": "Runs every day at 8:00 AM to check for inactive users"
    },
    {
      "parameters": {
        "operation": "aggregate",
        "collection": "users",
        "query": "[\n  {\n    \"$match\": {\n      \"updatedAt\": {\n        \"$lt\": { \"$dateSubtract\": { \"startDate\": \"$$NOW\", \"unit\": \"day\", \"amount\": 7 } }\n      },\n      \"role\": \"user\"\n    }\n  },\n  {\n    \"$addFields\": {\n      \"daysSinceLastActivity\": {\n        \"$dateDiff\": {\n          \"startDate\": \"$updatedAt\",\n          \"endDate\": \"$$NOW\",\n          \"unit\": \"day\"\n        }\n      }\n    }\n  },\n  {\n    \"$addFields\": {\n      \"inactivitySegment\": {\n        \"$switch\": {\n          \"branches\": [\n            { \"case\": { \"$lte\": [\"$daysSinceLastActivity\", 13] }, \"then\": \"7-day\" },\n            { \"case\": { \"$lte\": [\"$daysSinceLastActivity\", 29] }, \"then\": \"14-day\" },\n            { \"case\": { \"$lte\": [\"$daysSinceLastActivity\", 59] }, \"then\": \"30-day\" },\n            { \"case\": { \"$gte\": [\"$daysSinceLastActivity\", 60] }, \"then\": \"60-day\" }\n          ],\n          \"default\": \"other\"\n        }\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 1,\n      \"displayName\": 1,\n      \"email\": 1,\n      \"inactivitySegment\": 1,\n      \"daysSinceLastActivity\": 1,\n      \"progress.completedLessons\": 1,\n      \"progress.learningTime\": 1,\n      \"subscription.plan\": 1\n    }\n  }\n]",
        "options": {}
      },
      "id": "mongo-inactive-users",
      "name": "MongoDB: Query Inactive Users",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        480,
        400
      ],
      "credentials": {
        "mongoDb": {
          "id": "MONGO_CREDENTIAL_ID",
          "name": "Darsy MongoDB"
        }
      },
      "notes": "Aggregation pipeline: finds users inactive 7+ days, calculates days since last activity, assigns segment"
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "7-day",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.inactivitySegment }}",
                    "rightValue": "7-day",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "14-day",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.inactivitySegment }}",
                    "rightValue": "14-day",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "30-day",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.inactivitySegment }}",
                    "rightValue": "30-day",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "60-day",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.inactivitySegment }}",
                    "rightValue": "60-day",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
